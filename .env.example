# Copie este arquivo para .env e preencha os valores.

# Porta do servidor Express (backend). Padrão: 5000
PORT=5000

# Conexão com o PostgreSQL (obrigatória). O docker-compose já sobe um banco
# compatível com esta URL na porta 5433. O servidor não inicia sem isso.
DATABASE_URL=postgres://prpg:prpg@localhost:5433/prpg

# Segredo usado para assinar os tokens JWT. OBRIGATÓRIO.
# Use uma string longa e aleatória (mínimo 32 caracteres em produção). O servidor
# não inicia sem isso. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# URL base da API consumida pelo frontend (Vite).
# Em produção, aponte para o domínio público (ex.: https://prpg.ufrpe.br).
# Em desenvolvimento pode deixar vazio (usa http://localhost:5000).
VITE_API_URL=

# Origem pública do site (onde mora a página de verificação de declarações).
# Usada para montar o link/QR code impresso na declaração de proficiência.
# Em produção aponte para um domínio HTTPS público (ex.: https://prpg.ufrpe.br).
# Em desenvolvimento pode deixar vazio (usa http://localhost:3000).
PUBLIC_SITE_URL=

# Ambiente de execução do servidor: development (padrão) ou production.
# Em production o CORS passa a restringir as origens (ver CORS_ORIGINS).
NODE_ENV=development

# Origens autorizadas a consumir a API via navegador, separadas por vírgula.
# Obrigatório em production e deve conter somente origens HTTPS públicas.
# Em desenvolvimento o CORS é liberado.
# Ex.: CORS_ORIGINS=https://prpg.ufrpe.br,https://www.prpg.ufrpe.br
CORS_ORIGINS=

# SMTP institucional para envio de e-mail (Fase I, PLANO.md — D-C5 em aberto:
# ainda não confirmado se existe). OPCIONAL: com qualquer um destes vazio, o
# servidor não tenta enviar — apenas registra a intenção em `notificacoes`
# com o erro "SMTP não configurado". Nada quebra na ausência deles.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PRPG/UFRPE <nao-responda@ufrpe.br>
